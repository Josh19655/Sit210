#define TRIG_PIN 3
#define ECHO_PIN 2
#define BIN_HEIGHT 30  // Height of bin in cm

void setup() {
  Serial.begin(9600);
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  Serial.println("Smart Bin Level Monitor Started...");
}

void loop() {
  long duration;
  int distance;

  // Send ultrasonic pulse
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  // Measure echo time
  duration = pulseIn(ECHO_PIN, HIGH);
  distance = duration * 0.034 / 2; // Convert to cm

  // Compute fill level
  int fillLevel = BIN_HEIGHT - distance;

  // Clamp fill level between 0–100%
  if (fillLevel < 0) fillLevel = 0;
  if (fillLevel > BIN_HEIGHT) fillLevel = BIN_HEIGHT;

  int percentage = map(fillLevel, 0, BIN_HEIGHT, 0, 100);

  // Display result
  Serial.print("Distance: ");
  Serial.print(distance);
  Serial.print(" cm | Fill Level: ");
  Serial.print(percentage);
  Serial.println("%");

  delay(2000); // Update every 2 seconds
}
